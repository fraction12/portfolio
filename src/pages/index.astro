---
// SSR: render on request, edge-cached 5 min fresh + 30 min stale-while-revalidate.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import CoverHero from '../components/CoverHero.astro';
import WorkReel from '../components/WorkReel.astro';
import { homeReel } from '../config/featured-work';
import { loadSignalData } from '../lib/data';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=1800');

const data = await loadSignalData();
const essays = data.essays.slice(0, 4);
const email = 'dushyantgarg3@gmail.com';
---

<Layout
  current="home"
  title="Dushyant Garg"
  description="Dushyant Garg — AI product engineer at Surround Sound Media. Tools for AI agents, research, and writing."
  ogImage="/og/home.png"
  includeIdentitySchema
>
  <CoverHero />

  <WorkReel entries={homeReel} />

  <section id="about" class="home-block" aria-labelledby="about-heading">
    <div class="home-block__inner about" data-motion-reveal>
      <h2 id="about-heading" class="home-block__title">About</h2>
      <p class="about__text">
        I'm an AI product engineer at Surround Sound Media. Outside work I build tools for AI agents, mostly small and
        local-first, and write about what I learn.
      </p>
    </div>
  </section>

  {essays.length > 0 && (
    <section id="writing" class="home-block" aria-labelledby="writing-heading">
      <div class="home-block__inner">
        <div class="home-block__head" data-motion-reveal>
          <h2 id="writing-heading" class="home-block__title">Writing</h2>
          <a class="home-block__all mono-label" href="/writing">All writing</a>
        </div>
        <ul class="essays" data-motion-reveal>
          {essays.map(essay => (
            <li>
              <a href={essay.link} target="_blank" rel="noopener noreferrer">
                <time class="mono-label" datetime={essay.publishedAt.toISOString()}>{essay.dateLabel}</time>
                <span class="essays__title">{essay.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section id="contact" class="home-block contact" aria-label="Contact">
    <div class="home-block__inner contact__inner" data-motion-reveal>
      <a class="contact__mail" href={`mailto:${email}`}>{email}</a>
      <div class="contact__links">
        <a class="btn" href="https://github.com/fraction12" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="btn" href="https://linkedin.com/in/dushyantgarg" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-block {
    position: relative;
    z-index: var(--z-content);
    padding-block: clamp(70px, 10vw, 130px);
    border-top: 1px solid var(--line);
  }

  .home-block__inner {
    max-width: var(--layout-max-w);
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .home-block__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(36px, 5vw, 60px);
  }

  .home-block__title {
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(3rem, 10vw, 8.5rem);
    line-height: 0.8;
    font-variation-settings: 'wdth' 110;
  }

  .home-block__all {
    color: var(--ivory-2);
    text-decoration: none;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line-3);
    white-space: nowrap;
  }

  .home-block__all:hover {
    color: var(--ivory);
    border-color: var(--ivory);
  }

  .about {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(20px, 5vw, 80px);
    align-items: start;
  }

  .about .home-block__title {
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 0.85;
  }

  .about__text {
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.45;
    color: var(--ivory-2);
    max-width: 34ch;
    text-wrap: pretty;
  }

  .essays {
    list-style: none;
    position: relative;
    isolation: isolate;
  }

  .essays li { border-top: 1px solid var(--line); }
  .essays li:last-child { border-bottom: 1px solid var(--line); }

  .essays a {
    position: relative;
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 24px;
    align-items: center;
    padding: 22px 8px;
    overflow: hidden;
    color: var(--ivory);
    text-decoration: none;
  }

  .essays a::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ivory);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.5s cubic-bezier(.2, .7, .2, 1);
  }

  .essays a:hover,
  .essays a:focus-visible { color: var(--ink); }

  .essays a:hover::before,
  .essays a:focus-visible::before { transform: scaleY(1); }

  .essays time { color: var(--dim); }
  .essays a:hover time { color: var(--ink-2); }

  .essays__title {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.2rem, 2.6vw, 2rem);
    line-height: 1.05;
    font-variation-settings: 'wdth' 90;
  }

  .contact__inner {
    display: grid;
    justify-items: center;
    gap: 26px;
    text-align: center;
  }

  .contact__mail {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.4rem, 5vw, 4rem);
    line-height: 1;
    font-variation-settings: 'wdth' 100;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(180deg, #2a2b30 0%, #6c7078 45%, #111215 55%, #6c7078 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: font-variation-settings 0.8s cubic-bezier(.2, .7, .2, 1);
  }

  .contact__mail:hover { font-variation-settings: 'wdth' 120; }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  @media (max-width: 720px) {
    .about { grid-template-columns: 1fr; }
    .essays a { grid-template-columns: 1fr; gap: 6px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .essays a::before, .contact__mail { transition: none; }
  }
</style>
