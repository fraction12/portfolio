---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import '../styles/base.css';
import '../styles/animations.css';

interface Props {
  title?: string;
  description?: string;
  current?: 'home' | 'tools' | 'writing' | 'contact';
  ogImage?: string;
  canonicalPath?: string;
  noindex?: boolean;
  /** When true, adds Person + WebSite JSON-LD for the canonical portfolio. Use on the home page only. */
  includeIdentitySchema?: boolean;
}

const {
  title = 'Dushyant Garg',
  description = 'Dushyant Garg — AI product engineer and builder at Surround Sound Media, making tools for AI agents.',
  current = 'home',
  ogImage = '/og-default.png',
  includeIdentitySchema = false,
  canonicalPath,
  noindex = false,
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL('https://dushyantgarg.com')).origin;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteOrigin);
if (!canonicalUrl.pathname.endsWith('/')) canonicalUrl.pathname += '/';
const canonical = canonicalUrl.toString();
const ogTitle = title.includes('Dushyant Garg') ? title : `${title} — Dushyant Garg`;

// Verification tokens are read from build-time env. Import.meta.env.PUBLIC_*
// is inlined into the client bundle — safe because verification tokens are
// already public-facing meta tags, not secrets.
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION as string | undefined;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION as string | undefined;

const personSchema = includeIdentitySchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      '@id': siteOrigin + '/#person',
      name: 'Dushyant Garg',
      url: siteOrigin + '/',
      description:
        'AI product engineer and builder at Surround Sound Media, making practical AI products and open-source tools for AI agents.',
      jobTitle: 'AI Product Engineer',
      worksFor: { '@type': 'Organization', name: 'Surround Sound Media' },
      sameAs: [
        'https://github.com/fraction12',
        'https://linkedin.com/in/dushyantgarg',
        'https://dushyantg.substack.com',
      ],
    }
  : null;

const websiteSchema = includeIdentitySchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': siteOrigin + '/#website',
      name: 'Dushyant Garg',
      url: siteOrigin + '/',
      description:
        'Canonical portfolio of Dushyant Garg — product work, open-source builds, and writing.',
      author: {
        '@type': 'Person',
        '@id': siteOrigin + '/#person',
        name: 'Dushyant Garg',
        url: siteOrigin + '/',
      },
    }
  : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#ece8e1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, canonical).toString()} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, canonical).toString()} />
  {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
  {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="describedby" type="text/plain" href={new URL('/llms.txt', siteOrigin).href} title="Portfolio summary for AI readers" />
  <link rel="alternate" type="text/plain" href={new URL('/llms-full.txt', siteOrigin).href} title="Full portfolio for AI readers" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&family=Funnel+Sans:ital,wght@0,300..800;1,300..800&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  {personSchema && <JsonLd data={personSchema} />}
  {websiteSchema && <JsonLd data={websiteSchema} />}
  <slot name="head" />
  <ClientRouter fallback="animate" />
  <!-- Cloudflare Web Analytics -->
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "c33d546f96f44238b04d4e0e662507c8"}'></script>
  <!-- End Cloudflare Web Analytics -->
</head>
<body>
  <Nav current={current} />

  <main class="page-main" transition:animate="fade" transition:name="page-content">
    <slot />
  </main>

  <Footer />

  <script>
    import '../scripts/portfolio-motion';
  </script>
</body>
</html>
