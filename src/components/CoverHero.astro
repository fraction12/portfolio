---
// The homepage cover: who this is, then a plaster window onto a painted night
// garden. The garden is a stack of painted layers (docs/assets/garden) that
// shift with the pointer; the markup renders complete without any script.
import { gardenForegroundTravel, gardenInsects, gardenInsectTravel, gardenLayers } from '../config/garden';

// Firefly positions (% of the scene) and start delays (s).
const fireflies = [
  [22, 58, 0], [38, 52, 1.7], [61, 55, 3.1], [74, 49, 0.8], [47, 63, 2.4],
  [30, 66, 4.2], [68, 64, 1.2], [55, 47, 3.6], [15, 50, 2.9], [83, 58, 0.4],
];
---

<header class="cover" data-cover>
  <canvas class="cover__stars" aria-hidden="true" data-cover-stars></canvas>
  <div class="cover__inner">
    <p class="cover__kicker mono-label">AI product engineer · Surround Sound Media</p>
    <h1 class="cover__name">Dushyant Garg</h1>
    <p class="cover__line">I build tools for AI agents, and write about what I learn.</p>

    <div class="window" aria-hidden="true">
      <div class="niche">
        <div class="pane" data-cover-pane>
          <div class="stage">
            {gardenLayers.map((layer, index) => (
              <img
                class="layer"
                src={`/garden/${layer.name}.webp`}
                alt=""
                width="1000"
                height="1500"
                decoding="async"
                fetchpriority={index === 0 ? 'high' : undefined}
                style={`--travel: ${layer.travel};`}
              />
            ))}

            <div class="layer layer--life" style={`--travel: ${gardenInsectTravel};`}>
              {fireflies.map(([x, y, delay]) => (
                <span class="firefly" style={`left: ${x}%; top: ${y}%; --delay: ${delay}s;`}></span>
              ))}
              {gardenInsects.map(insect => (
                <span
                  class:list={['insect', `insect--${insect.name}`]}
                  style={`left: ${insect.x}%; top: ${insect.y}%; width: ${insect.size}%; --rotate: ${insect.rotate}deg; --drift: ${insect.drift}s; --flap: ${insect.flap}s;`}
                >
                  <img class="insect__open" src={`/garden/${insect.name}.webp`} alt="" width="200" height="200" decoding="async" />
                  {insect.closed && (
                    <img class="insect__closed" src={`/garden/${insect.closed}.webp`} alt="" width="200" height="200" decoding="async" />
                  )}
                </span>
              ))}
            </div>

            <div class="layer layer--foreground" style={`--travel: ${gardenForegroundTravel};`}>
              <img src="/garden/foreground.webp" alt="" width="1000" height="1500" decoding="async" />
            </div>
          </div>
          <span class="glass"></span>
          <span class="bar bar--h"></span>
          <span class="bar bar--v"></span>
        </div>
      </div>
      <div class="sill"></div>
    </div>
  </div>
</header>

<script>
  import { initGardenParallax } from '../scripts/garden-parallax';

  let stops: Array<() => void> = [];

  function start() {
    const cover = document.querySelector<HTMLElement>('[data-cover]');
    if (!cover) return;
    const pane = cover.querySelector<HTMLElement>('[data-cover-pane]');
    const stars = cover.querySelector<HTMLCanvasElement>('[data-cover-stars]');
    if (pane) stops.push(initGardenParallax(pane));
    if (stars) {
      import('../scripts/chrome-stars.js')
        .then(({ initChromeStars }) => initChromeStars(cover, stars))
        .then(stop => { if (document.contains(cover)) stops.push(stop); else stop(); })
        .catch(() => {});
    }
  }

  function stop() {
    stops.forEach(fn => fn());
    stops = [];
  }

  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', stop);
</script>

<style>
  .cover {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(18px, 3vw, 30px) clamp(48px, 7vw, 96px);
  }

  .cover__stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    pointer-events: none;
  }

  .cover__inner {
    position: relative;
    max-width: var(--layout-max-w);
    margin: 0 auto;
    padding-inline: var(--gutter);
    display: grid;
    justify-items: center;
  }

  .cover__kicker {
    margin-top: clamp(20px, 4vw, 48px);
    font-size: 12.5px;
    color: var(--ivory-2);
    text-align: center;
  }

  .cover__name {
    margin-top: 12px;
    font-weight: 700;
    font-size: var(--type-hero-name-size);
    line-height: 1;
    letter-spacing: -0.05em;
    text-align: center;
  }

  .cover__line {
    margin-top: 14px;
    max-width: 40ch;
    text-align: center;
    font-size: clamp(16px, 1.6vw, 19px);
    color: var(--dim);
    text-wrap: balance;
  }

  /* Fade and settle, one piece after another. */
  @media (prefers-reduced-motion: no-preference) {
    .cover__kicker,
    .cover__name,
    .cover__line,
    .window {
      animation: settle 0.9s cubic-bezier(.2, .7, .2, 1) both;
    }
    .cover__name { animation-delay: 0.1s; }
    .cover__line { animation-delay: 0.23s; }
    .window { animation-delay: 0.35s; }
  }

  @keyframes settle {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  /* ---- the window ---- */
  .window {
    position: relative;
    z-index: 2;
    display: grid;
    width: min(380px, 78vw);
    margin-top: clamp(28px, 4vw, 44px);
  }

  .niche {
    position: relative;
    aspect-ratio: 3 / 4.3;
    border-radius: 999px 999px 6px 6px;
    overflow: hidden;
    background: linear-gradient(180deg, var(--ink-2), var(--ink-1));
    box-shadow:
      inset 14px 0 26px -10px rgba(0, 0, 0, 0.22),
      inset -14px 0 26px -12px rgba(255, 255, 255, 0.7),
      inset 0 22px 40px -18px rgba(0, 0, 0, 0.25);
    outline: 10px solid var(--ink);
    outline-offset: -1px;
  }

  .niche::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(13, 13, 15, 0.08);
  }

  .pane {
    position: absolute;
    inset: 16px 16px 0;
    border-radius: 999px 999px 0 0;
    overflow: hidden;
    background: radial-gradient(ellipse 90% 70% at 50% 60%, #0f0b0d 0%, #030203 80%);
    box-shadow: 0 0 0 1px rgba(13, 13, 15, 0.25);
  }

  /* The stage matches the artwork (2:3) and fills the pane's height. The pane
     is always a little narrower than 2:3, so the sides crop evenly and the
     window bars at 34% line up with the painting. */
  .stage {
    position: absolute;
    top: 0;
    left: 50%;
    height: 100%;
    aspect-ratio: 2 / 3;
    transform: translateX(-50%);
  }

  /* Each layer moves with the pointer by its own travel (px), driven by
     --gx / --gy in [-1, 1]. The slight scale hides the edges as it moves. */
  .layer {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    transform:
      translate3d(calc(var(--gx, 0) * var(--travel) * 1px), calc(var(--gy, 0) * var(--travel) * 0.6px), 0)
      scale(1.08);
  }

  .layer--foreground img {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: 50% 100%;
  }

  .insect {
    position: absolute;
    aspect-ratio: 1;
    translate: -50% -50%;
    rotate: var(--rotate);
  }

  .insect img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .insect__closed { opacity: 0; }

  .firefly {
    position: absolute;
    width: 5px;
    height: 5px;
    margin: -2.5px 0 0 -2.5px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 233, 160, 0.95), rgba(255, 214, 120, 0) 70%);
    box-shadow: 0 0 10px 3px rgba(255, 210, 120, 0.35);
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* A breeze through the flowers at the glass. */
    .layer--foreground img { animation: breeze 9s ease-in-out infinite; }

    /* Butterflies drift in slow loops and close their wings now and then;
       the dragonfly and bee hover in place. */
    .insect { animation: drift var(--drift) ease-in-out infinite; }
    .insect__closed { animation: flap var(--flap) steps(1, end) infinite; }
    .insect--dragonfly,
    .insect--bee { animation-name: hover; }

    .firefly { animation: glow 4.5s ease-in-out var(--delay) infinite, float 11s ease-in-out var(--delay) infinite; }
  }

  @keyframes breeze {
    0%, 100% { transform: rotate(0deg) translateX(0); }
    50% { transform: rotate(0.35deg) translateX(1.5px); }
  }

  @keyframes drift {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(18%, -22%) rotate(4deg); }
    50% { transform: translate(34%, -6%) rotate(-3deg); }
    75% { transform: translate(12%, 14%) rotate(2deg); }
  }

  @keyframes hover {
    0%, 100% { transform: translate(0, 0); }
    30% { transform: translate(6%, -5%); }
    60% { transform: translate(-4%, 3%); }
  }

  /* Wings mostly open, with two quick beats per cycle. */
  @keyframes flap {
    0%, 62% { opacity: 0; }
    64% { opacity: 1; }
    67% { opacity: 0; }
    70% { opacity: 1; }
    73%, 100% { opacity: 0; }
  }

  @keyframes glow {
    0%, 100% { opacity: 0.15; }
    50% { opacity: 0.9; }
  }

  @keyframes float {
    0%, 100% { translate: 0 0; }
    50% { translate: 8px -12px; }
  }

  .glass {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(118deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.02) 22%, transparent 40%, rgba(255, 255, 255, 0.04) 70%, transparent 80%);
    box-shadow:
      inset 18px 0 24px -14px rgba(0, 0, 0, 0.85),
      inset 0 22px 30px -18px rgba(0, 0, 0, 0.8),
      inset -10px 0 20px -14px rgba(0, 0, 0, 0.6);
  }

  .bar {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(180deg, #f3efe8, #d8d1c5);
    box-shadow: 0 8px 12px -4px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(13, 13, 15, 0.12);
  }

  .bar--h { left: 0; right: 0; top: 34%; height: 8px; }
  .bar--v { top: 0; height: 34%; left: 50%; width: 8px; margin-left: -4px; background: linear-gradient(90deg, #f3efe8, #d8d1c5); }

  .sill {
    position: relative;
    z-index: 3;
    height: 18px;
    margin: 0 -18px;
    border-radius: 3px;
    background: linear-gradient(180deg, #f4f1eb 0%, #e2ddd3 55%, #cbc4b8 100%);
    box-shadow: 0 16px 20px -10px rgba(0, 0, 0, 0.35), 0 1px 0 rgba(255, 255, 255, 0.8) inset;
  }

  @media (max-width: 600px) {
    .window { width: min(300px, 76vw); }
  }
</style>
